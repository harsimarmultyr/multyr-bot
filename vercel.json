{
  "version": 2,
  "builds": [
    {
      "src": "src/index.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/digest.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/webhook",
      "dest": "src/index.ts"
    },
    {
      "src": "/api/health",
      "dest": "src/index.ts"
    },
    {
      "src": "/api/digest",
      "dest": "api/digest.ts"
    }
  ],
  "crons": [
    {
      "path": "/api/digest",
      "schedule": "0 9 * * *"
    }
  ]
}
